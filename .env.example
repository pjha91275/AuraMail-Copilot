# Server Configuration
PORT=5000
NODE_ENV=development

# 1. MongoDB Atlas Connection URI (Optional: Falls back to in-memory store if omitted)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/auramail?retryWrites=true&w=majority

# 2. Google Gemini LLM API Key (Optional: Falls back to zero-latency heuristic engine if omitted)
# AI_API_KEY=your_gemini_api_key_from_google_ai_studio

# 3. Google Workspace OAuth 2.0 Credentials (Optional: 1-Click demo access is enabled by default)
# Get from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://auramail-copilot.vercel.app/api/auth/google/callback
