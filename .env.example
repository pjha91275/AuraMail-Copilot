# Server Configuration
PORT=5000
NODE_ENV=development

# Optional: MongoDB Atlas URI (If omitted, AuraMail automatically runs in-memory with pre-seeded data)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/auramail?retryWrites=true&w=majority

# Optional: Live LLM API Key (OpenAI / Groq / Gemini). If omitted, AuraMail uses its built-in zero-latency NLP pipeline.
# AI_API_KEY=your_api_key_here
